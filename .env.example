# Local development / testing only. Railway deployments get these from the template.
# Copy to .env and adjust. Never commit .env.

# --- postgres service --------------------------------------------------------------------------
POSTGRES_USER=splitpro
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=splitpro

# --- splitpro service --------------------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0
DATABASE_URL=postgresql://splitpro:change-me-locally@postgres:5432/splitpro
# openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-64-hex-characters
NEXTAUTH_URL=http://localhost:3000
DEFAULT_HOMEPAGE=/balances
ENABLE_SENDING_INVITES=true
DISABLE_EMAIL_SIGNUP=false

# SMTP (required unless you configure Google or OIDC below)
FROM_EMAIL=splitpro@example.com
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_TLS_REJECT_UNAUTHORIZED=1

# Optional providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_NAME=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_WELL_KNOWN_URL=

# Wrapper knobs
DB_WAIT_TIMEOUT=180
APP_READY_TIMEOUT=300
